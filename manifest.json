{
  "manifest_version": 3,
  "name": "Easel - your Canvas dashboard in every new tab",
  "version": "1.0.0",
  "description": "A clean overview of your classes, assignments, and week ahead.",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": ["storage", "search", "favicon"],
  "optional_host_permissions": ["https://*/*"],
  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  }
}
